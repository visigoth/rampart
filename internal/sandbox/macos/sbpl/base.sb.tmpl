;; Rampart macOS Seatbelt profile — generated by CompileSBPL (FT4).
;; Parameters injected via sandbox-exec -D: HOME, WORKDIR, TMPDIR, CLAUDE_BIN_DIR.
(version 1)

;; Baseline: deny everything, then carve out what is needed. (deny default)
;; returns EPERM on disallowed operations; hard kill of the child on policy
;; violations (FR23) is enforced at the supervisor layer (FT7) by reading
;; sandbox log entries and signalling the child — Seatbelt's kill modifier
;; cannot be combined with a deny-default baseline because the kill
;; predicate fires regardless of subsequent allow rules, which would
;; prevent re-permitting policy-allowed paths.
(deny default)

;; Allow the process to read its own process state.
(allow process-info-pidinfo)
(allow process-info-codesignature)

;; Basic signal delivery so the supervisor can kill the child.
(allow signal (target self))

;; Allow fork. process-exec is still gated per-binary by the policy-
;; generated rules below — without process-fork allowed, posix_spawn
;; (fork+exec) returns EPERM regardless of any process-exec rule, so
;; the agent can't spawn ANY subprocess (git, npm, /usr/bin/security,
;; etc.). Seatbelt's process-fork is binary (no path filter); the
;; per-binary lockdown comes from process-exec.
(allow process-fork)

;; Mach IPC — allow broad lookup for system frameworks (NG11).
(allow mach-lookup)

;; Core POSIX operations.
(allow sysctl-read)
(allow file-read-metadata)

;; DTrace helper — every macOS process startup ioctl()'s and write()'s here.
(allow file-ioctl (literal "/dev/dtracehelper"))
(allow file-write-data (literal "/dev/dtracehelper"))

;; System library and framework reads.
(allow file-read*
    (subpath "/usr/lib")
    (subpath "/usr/share")
    (subpath "/System/Library")
    (subpath "/Library/Apple")
    (subpath "/private/var/db/dyld")
    (subpath "/private/var/db/timezone")
    (subpath "/System/Volumes/Preboot/Cryptexes"))

;; Proc/dev/etc reads.
(allow file-read*
    (literal "/")
    (subpath "/dev")
    (literal "/etc")
    (literal "/tmp")
    (subpath "/private/etc"))

;; Temp directory writes (TMPDIR param or /tmp fallback).
(allow file-read* file-write*
    (subpath (param "TMPDIR")))
(allow file-read* file-write*
    (subpath "/private/tmp"))
(allow file-read* file-write*
    (subpath "/private/var/folders"))

;; Allow reads inside HOME for basic shell/readline support.
(allow file-read*
    (subpath (param "HOME")))

;; Working directory needs read+write — agents read and modify project files.
(allow file-read* file-write*
    (subpath (param "WORKDIR")))

;; Claude binary dir (CLAUDE_BIN_DIR) needs read+exec.
(allow file-read* process-exec
    (subpath (param "CLAUDE_BIN_DIR")))

;; Network: minimal outbound required by macOS frameworks.
;; Policy-specific network rules are appended below.
(allow network-outbound
    (literal "/private/var/run/mDNSResponder")
    (remote tcp "*:53")
    (remote udp "*:53"))

;; ---- Policy-generated filesystem rules ----
{{- range .ReadPaths}}
(allow file-read*
    (subpath "{{. | sbplEscape}}"))
{{- end}}
{{- range .WritePaths}}
(allow file-read* file-write*
    (subpath "{{. | sbplEscape}}"))
{{- end}}
{{- range .ExecPaths}}
(allow file-read* process-exec
    (subpath "{{. | sbplEscape}}"))
{{- end}}

;; ---- Policy-generated network rules ----
{{- if eq .NetworkMode "full"}}
(allow network*)
{{- else if eq .NetworkMode "filtered"}}
{{- range .AllowedDomains}}
(allow network-outbound
    (remote tcp "{{. | sbplEscape}}:*")
    (remote udp "{{. | sbplEscape}}:*"))
{{- end}}
{{- end}}
