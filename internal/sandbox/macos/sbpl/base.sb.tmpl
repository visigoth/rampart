;; Rampart macOS Seatbelt profile — generated by CompileSBPL (FT4).
;; Parameters injected via sandbox-exec -D: HOME, WORKDIR, TMPDIR, CLAUDE_BIN_DIR.
(version 1)

;; Baseline: deny everything, then carve out what is needed. (deny default)
;; returns EPERM on disallowed operations; hard kill of the child on policy
;; violations (FR23) is enforced at the supervisor layer (FT7) by reading
;; sandbox log entries and signalling the child — Seatbelt's kill modifier
;; cannot be combined with a deny-default baseline because the kill
;; predicate fires regardless of subsequent allow rules, which would
;; prevent re-permitting policy-allowed paths.
(deny default)

;; Allow the process to read its own process state.
(allow process-info-pidinfo)
(allow process-info-codesignature)

;; Basic signal delivery so the supervisor can kill the child.
(allow signal (target self))

;; Allow fork. process-exec is still gated per-binary by the policy-
;; generated rules below — without process-fork allowed, posix_spawn
;; (fork+exec) returns EPERM regardless of any process-exec rule, so
;; the agent can't spawn ANY subprocess (git, npm, /usr/bin/security,
;; etc.). Seatbelt's process-fork is binary (no path filter); the
;; per-binary lockdown comes from process-exec.
(allow process-fork)

;; Mach IPC — allow broad lookup for system frameworks (NG11).
(allow mach-lookup)

;; Core POSIX operations.
(allow sysctl-read)
(allow file-read-metadata)

;; DTrace helper — every macOS process startup ioctl()'s and write()'s here.
(allow file-ioctl (literal "/dev/dtracehelper"))
(allow file-write-data (literal "/dev/dtracehelper"))

;; Terminal devices and other /dev character devices. Interactive agents
;; need write + ioctl on the controlling tty (TIOCSETA for raw mode,
;; TIOCGWINSZ for window size) and write on /dev/null for common
;; redirects. /dev is already broadly readable above; granting
;; write-data + ioctl here is the missing piece for TUIs.
(allow file-ioctl
    (subpath "/dev"))
(allow file-write-data
    (subpath "/dev"))

;; System library and framework reads.
(allow file-read*
    (subpath "/usr/lib")
    (subpath "/usr/share")
    (subpath "/System/Library")
    (subpath "/Library/Apple")
    (subpath "/private/var/db/dyld")
    (subpath "/private/var/db/timezone")
    (subpath "/System/Volumes/Preboot/Cryptexes"))

;; Homebrew prefixes. macOS dyld needs to open shared libraries any
;; allowlisted Homebrew binary links against — typically under
;; /opt/homebrew/opt/<formula>/lib (Apple Silicon) or /usr/local/opt
;; (Intel Homebrew). Without read access here every Homebrew binary
;; (including claude, tig, gh, etc.) fails to start with
;;   dyld: "file system sandbox blocked open()"
;; even when its exec path is explicitly allowed. process-exec is still
;; gated by per-binary rules from the policy; this is read-only.
(allow file-read*
    (subpath "/opt/homebrew")
    (subpath "/usr/local"))

;; Proc/dev/etc reads.
(allow file-read*
    (literal "/")
    (subpath "/dev")
    (literal "/etc")
    (literal "/tmp")
    (subpath "/private/etc"))

;; Temp directory writes (TMPDIR param or /tmp fallback).
(allow file-read* file-write*
    (subpath (param "TMPDIR")))
(allow file-read* file-write*
    (subpath "/private/tmp"))
(allow file-read* file-write*
    (subpath "/private/var/folders"))

;; Allow reads inside HOME for basic shell/readline support.
(allow file-read*
    (subpath (param "HOME")))

;; Working directory needs read+write — agents read and modify project files.
(allow file-read* file-write*
    (subpath (param "WORKDIR")))

;; Claude binary dir (CLAUDE_BIN_DIR) needs read+exec.
(allow file-read* process-exec
    (subpath (param "CLAUDE_BIN_DIR")))

;; Network: minimal outbound required by macOS frameworks.
;; Policy-specific network rules are appended below.
(allow network-outbound
    (literal "/private/var/run/mDNSResponder")
    (remote tcp "*:53")
    (remote udp "*:53"))

;; ---- Policy-generated filesystem rules ----
{{- range .ReadPaths}}
(allow file-read*
    (subpath "{{. | sbplEscape}}"))
{{- end}}
{{- range .WritePaths}}
(allow file-read* file-write*
    (subpath "{{. | sbplEscape}}"))
{{- end}}
{{- range .ExecPaths}}
(allow file-read* process-exec
    (subpath "{{. | sbplEscape}}"))
{{- end}}

;; ---- Policy-generated network rules ----
{{- if eq .NetworkMode "full"}}
(allow network*)
{{- else if eq .NetworkMode "filtered"}}
;; Loopback. The rampart forward proxy binds on 127.0.0.1:<random-port>
;; and injects HTTP_PROXY/HTTPS_PROXY into the agent's env — every
;; HTTPS request the agent makes goes through this. Without a loopback
;; rule the proxy connect hits a sandbox deny, the TCP handshake hangs,
;; and the agent's event loop blocks indefinitely (this manifested as
;; "claude is running but doesn't respond to keystrokes"). Local dev
;; servers and language servers also live here.
;;
;; Seatbelt's `remote tcp` syntax only accepts `*` or `localhost` for the
;; host portion (numeric IPs error out at policy load time); the
;; `localhost` keyword matches both 127.0.0.1 and ::1 at the kernel.
(allow network-outbound (remote tcp "localhost:*"))
{{- range .AllowedDomains}}
(allow network-outbound
    (remote tcp "{{. | sbplEscape}}:*")
    (remote udp "{{. | sbplEscape}}:*"))
{{- end}}
{{- end}}

;; ---- Unix-domain sockets ----
;; Seatbelt classifies AF_UNIX I/O as network operations distinct from
;; file-read/file-write on the socket inode. Two ops show up for the
;; agents we care about:
;;
;;   connect(2)  → network-outbound  (ssh-agent client, Docker client,
;;                 op-ssh-autopen client)
;;   bind(2)     → network-bind      (ssh ControlMaster listener,
;;                 anything that creates a unix-domain listener)
;;
;; Modules declare allowed socket paths or directories via
;; `unix_sockets = [...]`. Each entry produces BOTH a network-outbound
;; AND a network-bind allow, and uses (subpath ...) rather than
;; (literal ...) so a single entry covers:
;;   - the path itself (works for an exact socket like agent.sock)
;;   - any file under it (works for a directory like ~/.ssh/cm where
;;     ssh creates "<user>@<host>:<port>.<random-suffix>" temp sockets
;;     then atomically renames to the final name)
{{- range .UnixSockets}}
(allow network-outbound (subpath "{{. | sbplEscape}}"))
(allow network-bind     (subpath "{{. | sbplEscape}}"))
{{- end}}
